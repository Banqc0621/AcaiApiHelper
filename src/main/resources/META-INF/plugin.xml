<?xml version="1.0" encoding="UTF-8"?>
<!-- Plugin Configuration File - RestAutoLab 调试与测试插件 -->
<!-- 参考文档: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- 插件唯一标识（FQN格式），版本间不可更改 -->
    <id>com.banqc.restautolab</id>

    <!-- 插件显示名称 -->
    <name>RestAutoLab</name>

    <version>1.0.0</version>

    <!-- 供应商信息 -->
    <vendor>RestAutoLab</vendor>

    <!-- 插件描述 - 在插件市场和IDE插件管理器中展示 -->
    <description><![CDATA[
        RestAutoLab is an enterprise-grade API debugging and automated testing plugin for IntelliJ IDEA. It provides built-in HTTP debugging, API scanning, AI parameter generation, test case management, and Git pre-commit checks.
        <h2>RestAutoLab - 企业级API调试与自动化测试插件</h2>
        <p>面向 Java 服务开发与测试场景的 IDEA 内置 API 调试工具：</p>
        <ul>
            <li><b>API自动扫描</b>：自动识别Spring MVC / REST控制器中的接口定义</li>
            <li><b>接口树形管理</b>：按控制器分组展示所有API，支持搜索和代码跳转</li>
            <li><b>HTTP接口调试</b>：支持GET/POST/PUT/DELETE/PATCH等全部HTTP方法</li>
            <li><b>AI参数生成</b>：支持自部署模型（兼容 OpenAI 协议），智能生成测试入参数据</li>
            <li><b>测试用例管理</b>：支持本地测试用例的导入/导出/编辑</li>
            <li><b>自动化测试</b>：批量执行接口测试，生成测试报告</li>
            <li><b>Git预提交检查</b>：接口测试未通过（非200状态码）时阻断提交</li>
            <li><b>编辑器Gutter导航</b>：在代码行号旁显示API图标，快速调试</li>
        </ul>
        <h3>📦 兼容版本（v1.0.0 公开版）</h3>
        <p>插件基于 <code>org.jetbrains.intellij.platform</code> 构建（<b>Java 17</b> 编译），<code>idea-version</code> 声明为 <b>since-build="223" / until-build="261.*"</b>，覆盖 <b>4 年</b>共 11 个大版本：</p>
        <ul>
            <li>✅ <b>IntelliJ IDEA 2022.3 / 2022.3.x</b>（最低支持）</li>
            <li>✅ <b>IntelliJ IDEA 2023.1 / 2023.2 / 2023.3</b> 及子版本</li>
            <li>✅ <b>IntelliJ IDEA 2024.1 / 2024.2 / 2024.3</b> 及子版本</li>
            <li>✅ <b>IntelliJ IDEA 2025.1 / 2025.2 / 2025.3</b> 及子版本</li>
            <li>✅ <b>IntelliJ IDEA 2026.1 / 2026.1.x</b>（最高支持）</li>
            <li>❌ <b>2022.2 及以前</b>：物理上不支持（需要用老版 <code>gradle-intellij-plugin 1.x</code> 单独构建另一份插件）</li>
            <li>❌ <b>2026.2+</b>：暂不支持，需要等待下一版调整 <code>untilBuild</code></li>
        </ul>
        <p><b>安装提示</b>：请确认你的 IDE 版本在 <b>2022.3 ~ 2026.1.x</b> 范围内。
        可通过菜单 <code>Help → About</code> 查看当前 IDE 版本号（build 号 223 ~ 261）。</p>
    ]]></description>

    <!-- 变更日志 -->
    <change-notes><![CDATA[
        <h3>v1.0.0 公开首发（整合开发阶段能力，2026-08-24）</h3>
        <ul>
            <li><b>API 扫描</b>：支持按项目、目录或单个 Java 源文件精确扫描，空范围保持真实空态，不回退到旧结果。</li>
            <li><b>扫描稳定性</b>：同一 Controller 下相同 HTTP 方法与路径只保留一条；异步扫描使用 generation 防止旧结果覆盖新结果。</li>
            <li><b>IDEA 线程安全</b>：PSI、VFS、序列化和 UI 更新遵守后台读/写与 EDT 边界，异常统一转为可展示状态。</li>
            <li><b>接口调试与测试</b>：环境变量、请求历史、Cookie、断言、批量测试、依赖链和 HTML 报告等能力一并提供。</li>
            <li><b>数据与文档导出</b>：支持 cURL、Markdown、Postman、Word 模板及配置/接口数据导入导出。</li>
            <li><b>AI 与编辑器集成</b>：支持自部署模型，提供参数/断言生成、Gutter 导航、收藏文件夹和 Git 预提交检查。</li>
        </ul>
    ]]></change-notes>

    <!-- 平台兼容性要求 -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>Git4Idea</depends>

    <!-- 国际化资源包 -->
    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <!-- ================================================================ -->
    <!-- 扩展点声明 - 注册插件的核心功能组件                               -->
    <!-- ================================================================ -->
    <extensions defaultExtensionNs="com.intellij">

        <!-- 1. ToolWindow: 在IDE右侧显示API调试面板 -->
        <toolWindow id="RestAutoLab"
                    factoryClass="com.hronline.ui.RestAutoLabToolWindowFactory"
                    anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowPalette"
                    secondary="false"/>

        <!-- 2. Application级全局配置: IDE级别共享配置 -->
        <applicationService serviceImplementation="com.hronline.settings.RestAutoLabGlobalSettings"/>

        <!-- 2b. Project级持久化服务: 存储项目级配置（自部署模型网关地址、Token等） -->
        <projectService serviceImplementation="com.hronline.settings.RestAutoLabSettingsState"/>

        <!-- 3. 设置页面: 在IDE Settings中注册插件配置页 -->
        <projectConfigurable
                parentId="tools"
                instance="com.hronline.settings.RestAutoLabSettingsConfigurable"
                id="com.banqc.restautolab.settings"
                displayName="RestAutoLab"/>

        <!-- 5. Git预提交检查处理器: 接口测试未通过时阻断提交 -->
        <checkinHandlerFactory implementation="com.hronline.git.RestAutoLabCheckinHandler$Factory"/>

        <!-- 6. 编辑器Gutter图标提供器: 在Controller方法旁显示API调试图标 -->
        <codeInsight.lineMarkerProvider
                language="JAVA"
                implementationClass="com.hronline.gutter.ApiLineMarkerProvider"/>

        <!-- 7. API扫描服务 -->
        <projectService serviceImplementation="com.hronline.scanner.ApiScannerService"/>

        <!-- 8. HTTP执行服务 -->
        <projectService serviceImplementation="com.hronline.http.HttpExecutorService"/>

        <!-- 9. AI参数生成服务 -->
        <projectService serviceImplementation="com.hronline.ai.AiParameterService"/>

        <!-- 9b. ToolWindow面板持有服务: 供右键Action拿到树/调试面板，实现精准定位 -->
        <projectService serviceImplementation="com.hronline.ui.RestAutoLabToolWindowHolder"/>

        <!-- 10. 通知组: 用于在IDE底部展示操作结果通知 -->
        <notificationGroup id="RestAutoLab.Notification"
                           displayType="BALLOON"
                           bundle="messages.MyMessageBundle"
                           key="notification.group.name"/>
    </extensions>

    <!-- ================================================================ -->
    <!-- 动作声明 - 注册右键菜单、快捷键等交互入口                         -->
    <!-- ================================================================ -->
    <actions>
        <!-- 动作组: 注册到编辑器右键菜单 -->
        <group id="RestAutoLab.ActionGroup"
               text="RestAutoLab"
               popup="true"
               icon="AllIcons.Toolwindows.ToolWindowPalette">
            <!-- 将动作组添加到编辑器右键菜单（置顶） -->
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <!-- 将动作组添加到项目视图右键菜单（置顶） -->
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
        </group>

        <!-- 动作: 扫描此包接口（项目视图右键包目录/文件 → 收窄左侧接口列表；排菜单第 1 位） -->
        <action id="RestAutoLab.AddToScanPackage"
                class="com.hronline.actions.RestAutoLabActions$AddToScanPackageAction"
                text="扫描此包接口"
                description="仅扫描并显示此包/文件下的接口（点击左侧「全量」按钮恢复）"
                icon="AllIcons.Actions.GroupByPackage">
            <add-to-group group-id="RestAutoLab.ActionGroup" anchor="first"/>
        </action>

        <!-- 动作: 扫描项目API（排菜单第 2 位） -->
        <action id="RestAutoLab.ScanApis"
                class="com.hronline.actions.RestAutoLabActions$ScanApisAction"
                text="扫描项目API"
                description="扫描当前项目中的所有REST/Spring MVC接口"
                icon="AllIcons.Actions.Refresh">
            <add-to-group group-id="RestAutoLab.ActionGroup" anchor="after" relative-to-action="RestAutoLab.AddToScanPackage"/>
        </action>

        <!-- 动作: 运行接口测试（只对已扫描到的接口批量测试；排菜单第 3 位） -->
        <action id="RestAutoLab.RunAllTests"
                class="com.hronline.actions.RestAutoLabActions$RunAllTestsAction"
                text="运行接口测试"
                description="对已扫描到的接口执行批量自动化测试"
                icon="AllIcons.RunConfigurations.Junit">
            <add-to-group group-id="RestAutoLab.ActionGroup" anchor="after" relative-to-action="RestAutoLab.ScanApis"/>
        </action>

        <!-- 动作: 调试当前接口（排菜单第 4 位） -->
        <action id="RestAutoLab.DebugApi"
                class="com.hronline.actions.RestAutoLabActions$DebugApiAction"
                text="调试当前接口"
                description="在RestAutoLab面板中打开当前接口的调试界面"
                icon="AllIcons.Actions.Execute">
            <add-to-group group-id="RestAutoLab.ActionGroup" anchor="after" relative-to-action="RestAutoLab.RunAllTests"/>
        </action>
    </actions>
</idea-plugin>
